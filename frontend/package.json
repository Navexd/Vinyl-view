{
  "name": "vinyl-view",
  "version": "4.4.0",
  "description": "Spotify now-playing visualizer with animated vinyl turntable",
  "author": "Navexd",
  "license": "MIT",
  "main": "main.js",
  "type": "commonjs",

  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --linux"
  },

  "dependencies": {},

  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-is-dev": "^3.0.1"
  },

  "build": {
    "appId": "com.vinyl.view",
    "productName": "VinylView",
    "asar": true,
    "icon": "assets/album.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "settings.js",
      "src/**/*",
      "package.json",
      "!release/**/*",
      "!backend-linux/**/*",
      "!backend-win/**/*",
      "!log/**/*",
      "!lab/**/*"
    ],
    "extraResources": [
      {
        "from": "renderer",
        "to": "renderer",
        "filter": ["**/*"]
      },
      {
        "from": "assets",
        "to": "assets",
        "filter": ["**/*"]
      }
    ],
    "linux": {
      "icon": "assets/album.png",
      "target": ["AppImage"],
      "category": "AudioVideo",
      "extraResources": [
        {
          "from": "backend-linux",
          "to": "backend-linux",
          "filter": ["**/*"]
        }
      ],
      "fileAssociations": []
    },
    "win": {
      "icon": "assets/album.ico",
      "target": ["nsis"],
      "extraResources": [
        {
          "from": "backend-win",
          "to": "backend-win",
          "filter": ["**/*"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true
    }
  }
}